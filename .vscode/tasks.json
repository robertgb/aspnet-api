{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: local",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/aspnet-api.csproj"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "docker: dev",
      "type": "shell",
      "command": "docker compose up --build webapi",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "docker: dev background",
      "type": "shell",
      "command": "docker compose up --build -d webapi",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "docker: down",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
